# Django core (obligatoire si DEBUG=False)
# DJANGO_SECRET_KEY=...   # clé secrète forte (ou utiliser SECRET_KEY)
# ALLOWED_HOSTS=api.example.com,localhost
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://app.example.com   # optionnel ; par défaut = CORS en prod
# SECURE_SSL_REDIRECT=True   # défaut True hors DEBUG (derrière reverse proxy HTTPS)

# JWT : accès court + refresh long (session « longue » = les deux ensemble)
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=365

# Database Settings
DATABASE_URL = 'postgresql://user:password@host:port/dbname'

# E-mail : Resend (recommandé) — si RESEND_API_KEY est défini, le backend Resend est utilisé par défaut.
# https://resend.com/docs/send-with-python
RESEND_API_KEY = 're_xxxxxxxx'
# Adresse d’envoi vérifiée chez Resend (ex. onboarding@resend.dev en test, ou noreply@votredomaine.com)
DEFAULT_FROM_EMAIL = 'onboarding@resend.dev'

# SMTP (uniquement si vous n’utilisez pas Resend : ne pas définir RESEND_API_KEY ou forcer EMAIL_BACKEND)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Google Auth — scopes : openid, userinfo.email, userinfo.profile (sans People API).
GOOGLE_CLIENT_ID = 'your-google-client-id'
GOOGLE_CLIENT_SECRET = 'your-google-client-secret'

# Facebook Auth
FACEBOOK_CLIENT_ID = 'your-facebook-client-id'
FACEBOOK_CLIENT_SECRET = 'your-facebook-client-secret'

# Frontend URL
FRONTEND_URL = 'http://localhost:5173'

# FedaPay (le nom du marchand figurant sur le reçu, ex. « Payé à », se règle sur le compte FedaPay : nom de société / compte marchand.)
FEDAPAY_ENV = 'sandbox'
FEDAPAY_SECRET_KEY = 'sk_xxx'
FEDAPAY_CURRENCY_ISO = 'XOF'
FEDAPAY_CALLBACK_URL = 'http://localhost:5173/premium'
FEDAPAY_WEBHOOK_SECRET = 'change-me'

CURRENCY_RATES_API_URL = 'https://open.er-api.com/v6/latest'
CURRENCY_RATES_TIMEOUT_SECONDS = 8

WEB_PUSH_VAPID_PUBLIC_KEY = ''
WEB_PUSH_VAPID_PRIVATE_KEY = ''
WEB_PUSH_VAPID_CLAIMS_SUB = 'mailto:admin@pinova.local'

# Tâche planifiée (exemple) : supprimer les stories « éphémères » Plus/Pro après leur story_expires_at
# python manage.py purge_expired_ephemeral_stories
# 15 * * * * cd /chemin/projet/pinova-backend && .venv/bin/python manage.py purge_expired_ephemeral_stories
