# Django core (obligatoire si DEBUG=False)
# DJANGO_SECRET_KEY=...   # clé secrète forte (ou utiliser SECRET_KEY)
# ALLOWED_HOSTS=api.example.com,localhost
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://app.example.com   # optionnel ; par défaut = CORS en prod
# SECURE_SSL_REDIRECT=True   # défaut True hors DEBUG (derrière reverse proxy HTTPS)

# JWT : accès court (60 min) + refresh 30 jours — migration depuis 1440 min / 36500 jours.
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=30
# JWT_AUTH_HTTPONLY=1   # prod (défaut si DEBUG=False) : refresh cookie HttpOnly pour le web
# JWT_AUTH_HTTPONLY=0   # dev local : refresh aussi dans le JSON (localStorage web / SecureStore mobile)

# Throttles OTP (verify-otp / resend-otp) — DRF + django-ratelimit
# API_THROTTLE_OTP_VERIFY=10/minute
# API_THROTTLE_OTP_RESEND=3/minute
# API_RATELIMIT_OTP_VERIFY=10/minute
# API_RATELIMIT_OTP_RESEND=3/minute

# Cache partagé (Redis) — throttling DRF + django-ratelimit entre workers Gunicorn/uWSGI
# REDIS_URL=redis://127.0.0.1:6379/0
# PINNOVA_REDIS_URL=redis://127.0.0.1:6379/0   # alias
# RATELIMIT_ENABLE=True
# API_RATELIMIT_LOGIN=10/minute
# API_RATELIMIT_REGISTER=5/minute
# API_RATELIMIT_PASSWORD_RESET=5/minute
# API_RATELIMIT_WEBHOOK=100/minute

# Base de données
# Sans DATABASE_URL, DATABASE_DIRECT_URL ni POSTGRES_*/PG* : SQLite local (db.sqlite3).
#
# Supabase (PostgreSQL managé) — https://supabase.com/dashboard
# 1. Project Settings → API : SUPABASE_URL + clés publishable / secret
# 2. Bouton « Connect » → onglet ORM :
#    - DATABASE_URL = Transaction pooler (port 6543) — recommandé Render / IPv4
#    - DATABASE_DIRECT_URL = Direct (port 5432) — secours ou migrations si le pooler transaction échoue
#    - Session pooler (même host, port 5432) si direct IPv6 indisponible
# Les clés sb_publishable_ / sb_secret_ ne remplacent pas l’URL Postgres (mot de passe requis).
#
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Sécurité Supabase (PostgreSQL pour Django uniquement — pas d’accès direct front via supabase-js) :
# Alertes Advisor « RLS Disabled in Public » : normal si le schéma public est exposé à l’API Supabase.
# Si seul Django accède à la DB : exécuter scripts/supabase_postgres_hardening.sql dans le SQL Editor.

# E-mail : Resend (recommandé) — si RESEND_API_KEY est défini, le backend Resend est utilisé par défaut.
# https://resend.com/docs/send-with-python
RESEND_API_KEY = 're_xxxxxxxx'
# Adresse d’envoi vérifiée chez Resend (ex. onboarding@resend.dev en test, ou noreply@votredomaine.com)
DEFAULT_FROM_EMAIL = 'onboarding@resend.dev'

# SMTP (uniquement si vous n’utilisez pas Resend : ne pas définir RESEND_API_KEY ou forcer EMAIL_BACKEND)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Google Auth — scopes : openid, userinfo.email, userinfo.profile (sans People API).
GOOGLE_CLIENT_ID = 'your-google-client-id'
GOOGLE_CLIENT_SECRET = 'your-google-client-secret'

# Facebook Auth
FACEBOOK_CLIENT_ID = 'your-facebook-client-id'
FACEBOOK_CLIENT_SECRET = 'your-facebook-client-secret'

# Frontend URL
FRONTEND_URL = 'http://localhost:5173'

# FedaPay (le nom du marchand figurant sur le reçu, ex. « Payé à », se règle sur le compte FedaPay : nom de société / compte marchand.)
FEDAPAY_ENV = 'sandbox'
FEDAPAY_SECRET_KEY = 'sk_xxx'
FEDAPAY_CURRENCY_ISO = 'XOF'
FEDAPAY_CALLBACK_URL = 'http://localhost:5173/premium'
# Secret partagé avec FedaPay (en-tête X-Webhook-Token / X-Fedapay-Webhook-Token).
# Obligatoire en production (DEBUG=False) — le serveur refuse de démarrer le webhook sans secret.
# Rotation : générer un nouveau secret fort, mettre à jour FEDAPAY_WEBHOOK_SECRET + le tableau de bord
# FedaPay, redémarrer l’API, puis révoquer l’ancien secret côté FedaPay après la fenêtre de bascule.
FEDAPAY_WEBHOOK_SECRET = 'change-me'

# Pubs réseau (AdSense web / AdMob mobile) — en DEBUG, IDs de test Google si non définis.
# ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
# ADSENSE_SLOT_FEED=1234567890
# ADSENSE_SLOT_DETAIL=1234567891
# ADMOB_APP_ID_ANDROID=ca-app-pub-xxx~android
# ADMOB_APP_ID_IOS=ca-app-pub-xxx~ios
# ADMOB_UNIT_FEED_ANDROID=ca-app-pub-xxx/banner-feed
# ADMOB_UNIT_FEED_IOS=ca-app-pub-xxx/banner-feed
# ADMOB_UNIT_DETAIL_ANDROID=ca-app-pub-xxx/banner-detail
# ADMOB_UNIT_DETAIL_IOS=ca-app-pub-xxx/banner-detail
# NETWORK_AD_FEED_EVERY_N=10

CURRENCY_RATES_API_URL = 'https://open.er-api.com/v6/latest'
CURRENCY_RATES_TIMEOUT_SECONDS = 8

# Médias privés — URLs signées HMAC (TTL 1 h par défaut) ; obligatoire en prod pour pins/stories/avatars privés.
# MEDIA_SIGNING_SECRET=...   # défaut : DJANGO_SECRET_KEY
# MEDIA_SIGNED_URL_TTL_SECONDS=3600
# PINNOVA_MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
# PINNOVA_MEDIA_SIGNED_CACHE_CONTROL=private, max-age=3600
#
# Stockage objet S3 / Cloudflare R2 (bucket privé — servir via /media/ + middleware, pas d’accès direct bucket)
# USE_S3_MEDIA=1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=pinova-media
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# MEDIA_CDN_DOMAIN=cdn.example.com   # CDN devant l’origine /media/ (pins publics uniquement sans ?sig=)
#
# Stockage Cloudinary (CDN + f_auto/q_auto ; pins privés toujours via /media/ signé)
# USE_CLOUDINARY_MEDIA=1
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
#
# Uploads sécurisés (magic bytes + re-encodage Pillow)
# PIN_IMAGE_MAX_SIZE_MB=10
# PIN_IMAGE_JPEG_QUALITY=85
# ENABLE_CLAMAV_SCAN=1
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
#
# Sécurité HTTP / API (production DEBUG=False)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; img-src 'self' data: https:
# Audit endpoints publics : python manage.py audit_public_api_permissions
# Déploiement : python manage.py check --deploy

WEB_PUSH_VAPID_PUBLIC_KEY = ''
WEB_PUSH_VAPID_PRIVATE_KEY = ''
WEB_PUSH_VAPID_CLAIMS_SUB = 'mailto:admin@pinova.local'

# Tâches planifiées — Celery Beat (prod) ou manage.py (secours / dev sans worker)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_TIME_LIMIT=300
# Health : GET /api/health/ (liveness + dépendances)
#         GET /api/health/ready/ (readiness k8s/Render)
#         GET /api/health/celery/ (détail Celery)
# Worker : celery -A pinova_backend worker -l info
# Beat   : celery -A pinova_backend beat -l info
# Voir docs/DEPLOY.md et docs/OBSERVABILITY.md
#
# Seed (python seed_data.py — dev / démo)
# SEED_SKIP_NETWORK=0          # local : télécharger de vraies photos Picsum + portraits profil
# SEED_FORCE_NETWORK=1         # Render : forcer le téléchargement malgré RENDER=true (cache .seed_image_cache/)
# SEED_PIN_COUNT=420
# SEED_IMAGE_CACHE_DIR=.seed_image_cache
#
# OpenTelemetry (optionnel — tracing si endpoint OTLP défini)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces
# OTEL_SERVICE_NAME=pinova-backend
#
# Secours cron (si pas de beat) :
# python manage.py purge_expired_ephemeral_stories
# 15 * * * * cd /chemin/projet/pinova-backend && .venv/bin/python manage.py purge_expired_ephemeral_stories
